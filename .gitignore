# Files git should ignore, like build output and generated docs.

# Build output
/nuqs
/nuqs.exe
/dist/
*.test
*.out

# Generated docs (CI builds these from code comments)
/docs/api/
/docs/architecture.md
/site/

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# Docs tools installed by scripts/docs.sh
/.venv/
